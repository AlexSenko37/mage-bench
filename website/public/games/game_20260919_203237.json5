    "picks": [
      {
        "seat": "kimik3-max-A",
        "pick_number": 1,
        "round": 1,
        "pack": "pack1",
        "pack_cards": [
          "Forest",
          "Badgermole",
          "First-Time Flyer",
          "Watery Grasp",
          "Aang's Journey",
          "Cat-Owl",
          "Fire Nation Raider",
