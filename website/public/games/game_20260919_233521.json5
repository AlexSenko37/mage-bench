aste\"],\"id\":\"p22\",\"power\":\"3\",\"toughness\":\"3\",\"summoning_sick\":false},{\"tapped\":true,\"counters\":{\"+1/+1\":2},\"name\":\"Swamp\",\"rules\":[\"{T}: Add {B}.\",\"Haste\"],\"id\":\"p37\",\"power\":\"2\",\"toughness\":\"2\",\"summoning_sick\":false}],\"name\":\"PilotB\",\"exile\":[{\"name\":\"Earth Village Ruffians\",\"rules\":[\"When {this} dies, earthbend 2. (Target land you control becomes a 0/0 creature with haste that\\u0027s still a land. Put two +1/+1 counters on it. When it dies or is exiled, return it to the battlefield tapped.)\"],\"id\":\"p10\"}],\"library_size\":23,\"life\":16}],\"board_cursor\":156,\"choices\":[{\"controller\":\"PilotB\",\"name\":\"Boiling Rock Rioter\",\"target_type\":\"permanent\",\"index\":0,\"power\":\"3\",\"id\":\"p65\",\"toughness\":\"3\"},{\"name\":\"Messenger Hawk\",\"target_type\":\"permanent\",\"index\":1,\"power\":\"1\",\"id\":\"p29\",\"toughness\":\"2\"},{\"name\":\"Pirate Peddlers\",\"target_type\":\"permanent\",\"index\":2,\"power\":\"3\",\"id\":\"p52\",\"toughness\":\"3\"},{\"tapped\":true,\"controller\":\"PilotB\",\"name\":\"Swamp\",\"target_type\":\"permanent\",\"index\":3,\"power\":\"3\",\"id\":\"p22\",\"toughness\":\"3\"},{\"tapped\":true,\"controller\":\"PilotB\",\"name\":\"Swamp\",\"target_type\":\"permanent\",\"index\":4,\"power\":\"2\",\"id\":\"p37\",\"toughness\":\"2\"}],\"stack\":[{\"owner\":\"PilotA\",\"name\":\"Lost Days\"}],\"untapped_lands\":5,\"game_seq\":464,\"land_drops_used\":0,\"required\":false,\"can_cancel\":true,\"stop_reason\":\"non_priority_action\"}",
