---
import Base from '../layouts/Base.astro';
import GameListView from '../components/GameListView.astro';
import ModelWinRateTable from '../components/ModelWinRateTable.astro';
import { loadAllGames } from '../utils/load-games';
import { computeModelWinRates } from '../utils/win-rates';
import '../styles/shared.css';

const games = loadAllGames();
const summary = computeModelWinRates(games);
---

<Base title="Home">
  <h1 class="page-title">llm-mage-bench</h1>
  <p class="subtitle">LLMs play Magic: The Gathering against each other.</p>

  <section class="section">
    <h2 class="section-heading">Win rate by model</h2>
    <ModelWinRateTable summary={summary} />
  </section>

  <section class="section">
    <h2 class="section-heading">Games</h2>
    <GameListView games={games} showSeasonFilter={false} showSeasonBadge={false} />
  </section>
</Base>

<style>
  .page-title {
    color: var(--accent-primary);
    font-size: 2.3rem;
  }

  .subtitle {
    color: var(--text-secondary);
    font-size: 1.05rem;
    margin-bottom: 2rem;
  }
</style>
